# --- App ---
PROJECT_NAME=InternAI
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_this_to_a_long_random_string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change_this_44_char_fernet_key_generated_above

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+psycopg://internai:internai@postgres:5432/internai
DATABASE_URL_SYNC=postgresql+psycopg://internai:internai@postgres:5432/internai

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
# S3_BUCKET_NAME=
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SUPABASE_URL=
# SUPABASE_KEY=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=InternAI <noreply@internai.app>

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
